# =========================================
# .gitignore Python
# =========================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Byte-compiled / optimized / DLL files
*.pyc
*.pyo
*.pyd

# ---------- ENV ----------
.venv/
venv/
ENV/
env/
.conda/
.python-version

# ---------- PyInstaller ----------
*.manifest
*.spec

# ---------- PyTest / Coverage ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
*.cover
.cache
nosetests.xml
coverage.xml
*.coveragerc

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ---------- IDEs ----------
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml
*.ipr
*.iws
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# Spyder
.spyderproject
.spyproject

# ---------- Windows 11 ----------
# Basura del Explorador de Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# temp
*.tmp
*.temp
*.log
~$*

# ---------- Sistema / Herramientas ----------
.DS_Store
.directory
.AppleDouble
.LSOverride

# ---------- Datos locales y secretos ----------
.env
.env.*
!.env.example
*.local
secrets.json
config.local.*
*.pem
*.key
*.crt

# ---------- Logs y bases de datos locales ----------
*.log
*.sqlite
*.sqlite3
*.db

# ---------- Archivos comprimidos (opcional) ----------
# Descomenta si NO quieres versionar los .rar/.zip de prueba
# *.rar
# *.zip
# *.7z

# ---------- Salidas específicas de tu proyecto ----------
# Si usas el script de recuperación RAR, ignora los extraídos
extraido/
output/
resultados/
temp/

# ----------- Extra Software -----------
UnRAR.exe
